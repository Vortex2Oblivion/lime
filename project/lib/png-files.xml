<xml>

	<files id="native-toolkit-png-depends">
		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/png.h" />
	</files>

	<files id="native-toolkit-png" tags="">

		<cache value="1" />
		<tag value="${NATIVE_TOOLKIT_OPTIM_TAG}" if="NATIVE_TOOLKIT_OPTIM_TAG" />

		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/png/" />
		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/libpng/" />
		<compilerflag value="-I${NATIVE_TOOLKIT_PATH}/zlib/" />

		<depend files="native-toolkit-png-depends" />

		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/pngconf.h" />
		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/pngdebug.h" />
		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/pnginfo.h" />
		<depend name="${NATIVE_TOOLKIT_PATH}/custom/png/pnglibconf.h" />
		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/pngpriv.h" />
		<depend name="${NATIVE_TOOLKIT_PATH}/libpng/pngstruct.h" />

		<file name="${NATIVE_TOOLKIT_PATH}/libpng/png.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngerror.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngget.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngmem.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngpread.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngread.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngrio.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngrtran.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngrutil.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngset.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngtrans.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngwio.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngwrite.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngwtran.c" />
		<file name="${NATIVE_TOOLKIT_PATH}/libpng/pngwutil.c" />

		<section if="HXCPP_ARMV7 || HXCPP_ARMV7S || HXCPP_ARM64">

			<file name="${NATIVE_TOOLKIT_PATH}/libpng/arm/arm_init.c" />
			<file name="${NATIVE_TOOLKIT_PATH}/libpng/arm/filter_neon_intrinsics.c" />
			<file name="${NATIVE_TOOLKIT_PATH}/libpng/arm/palette_neon_intrinsics.c" />

		</section>

		<!-- libpng's SSE2 row filters on x86, which libpng only uses where PNG_INTEL_SSE is
		     defined for every file. They build to nothing where the compiler has no SSE2. -->
		<section unless="HXCPP_ARMV6 || HXCPP_ARMV7 || HXCPP_ARMV7S || HXCPP_ARM64 || rpi || emscripten">

			<compilerflag value="-DPNG_INTEL_SSE" />

			<file name="${NATIVE_TOOLKIT_PATH}/libpng/intel/intel_init.c" />
			<file name="${NATIVE_TOOLKIT_PATH}/libpng/intel/filter_sse2_intrinsics.c" />

		</section>

	</files>

</xml>